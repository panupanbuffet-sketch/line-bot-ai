# LINE Messaging API (from the LINE Developers Console)
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Gemini API key (Google AI Studio)
GEMINI_API_KEY=
# Optional, defaults to gemini-3.5-flash
GEMINI_MODEL=

# Published Google Sheet (File > Share > Publish to web > CSV) with the FAQ/menu data
SHEET_CSV_URL=

# Secret path segment for the remote MCP endpoint (app/api/mcp/[token]).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep this value private — anyone with it can call the LINE OA tools.
MCP_SECRET_TOKEN=

# Shared bot state (Upstash Redis REST, read/write token). Do not publish keys.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Use a different namespace and LINE test channel for preview deployments.
BOT_STATE_NAMESPACE=tasana-production
# Enable only after storage and LINE OA reply settings are ready.
BOT_ENABLED=false
# Separate random admin secret, at least 32 characters. Used at /admin.
BOT_ADMIN_TOKEN=

# Approved staff LINE user IDs; comma separated, server only
BOT_STAFF_IDS=
